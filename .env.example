# Local development only. Set a unique password; never commit .env.
POSTGRES_USER=chronos
POSTGRES_DB=chronos
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Set CHRONOS_DATABASE_URL in your shell for Alembic (URL-encode the password):
# postgresql+psycopg://chronos:YOUR_PASSWORD@localhost:5432/chronos
# Set CHRONOS_TEST_DATABASE_URL separately for disposable integration tests:
# postgresql://chronos:YOUR_PASSWORD@localhost:5432/chronos
